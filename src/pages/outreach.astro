---
import Layout from '../layouts/Layout.astro';
---

<Layout title={'Outreach — Marco Sanchioni'} description={'Popular writing, public essays and outreach articles by Marco Sanchioni on the philosophy and foundations of physics.'}>
<section class="page-hero">
    <div class="glow glow--accent glow--a" aria-hidden="true"></div>
    <div class="wrap reveal">
      <span class="eyebrow">Outreach</span>
      <h1>Writing &amp; essays</h1>
      <p class="lead serif" style="max-width:58ch;">Popular writing on physics, philosophy, and the ideas that connect them — published externally and on this site.</p>
    </div>
  </section>

  <!-- SCIENTIFIC DISSEMINATION -->
  <section class="band band--paper2">
    <div class="wrap">
      <div class="section-intro reveal"><h2>Scientific Dissemination</h2></div>

      <article class="pub reveal">
        <div class="year">2026</div>
        <div>
          <h3>Abitare l'intelligenza artificiale senza smarrire l'umano</h3>
          <p class="meta"><span class="venue">Città Nuova</span> · forthcoming</p>
        </div>
      </article>

      <article class="pub reveal">
        <div class="year">2026</div>
        <div>
          <h3>Sul senso dell'umano. Educazione, vocazione e intelligenza artificiale</h3>
          <p class="meta"><span class="venue">Dossier Città Nuova</span> · forthcoming</p>
        </div>
      </article>

      <article class="pub reveal">
        <div class="year">2026</div>
        <div>
          <h3>Quanto il tutto non è una somma: una lezione dalla complessità</h3>
          <p class="meta"><span class="venue">Nuova Umanità</span> · forthcoming</p>
        </div>
      </article>

      <article class="pub reveal">
        <div class="year">2026</div>
        <div>
          <h3>Magnifica Humanitas: la macchina prova dolore?</h3>
          <p class="meta"><span class="venue">Città Nuova</span></p>
        </div>
      </article>

      <article class="pub reveal">
        <div class="year">2026</div>
        <div>
          <h3>Magnifica Humanitas: ciò che la macchina non sa fare</h3>
          <p class="meta"><span class="venue">Città Nuova</span></p>
        </div>
      </article>

      <article class="pub reveal">
        <div class="year">2026</div>
        <div>
          <h3>La Magnifica Humanitas di papa Leone: la tecnologia ci interroga su chi siamo</h3>
          <p class="meta"><span class="venue">Città Nuova</span></p>
        </div>
      </article>

      <article class="pub reveal">
        <div class="year">2026</div>
        <div>
          <h3>Edgar Morin: tessere ciò che è separato</h3>
          <p class="meta"><span class="venue">Città Nuova</span></p>
        </div>
      </article>

      <article class="pub reveal">
        <div class="year">2025</div>
        <div>
          <h3>Le sfide dell'intelligenza artificiale</h3>
          <p class="meta">with C. Belzung · <span class="venue">Nuova Umanità</span></p>
        </div>
      </article>

      <article class="pub reveal">
        <div class="year">2025</div>
        <div>
          <h3>Cibernetica, tra passato e presente</h3>
          <p class="meta"><span class="venue">Nuova Umanità</span></p>
        </div>
      </article>

      <article class="pub reveal">
        <div class="year">2025</div>
        <div>
          <h3>Binomio tecnica–saggezza nell'era dell'intelligenza artificiale: verso un nuovo umanesimo</h3>
          <p class="meta"><span class="venue">Togetherness</span></p>
        </div>
      </article>

      <article class="pub reveal">
        <div class="year">2024</div>
        <div>
          <h3>Sul destino dell'universo</h3>
