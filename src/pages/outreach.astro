      </article>

    </div>
  </section>

  <!-- ESSAYS ON THIS SITE -->
  <section class="band">
    <div class="wrap">
      <div class="section-intro reveal"><h2>Essays</h2></div>
      <p class="lead serif reveal" style="max-width:60ch; color: var(--ink-soft);">Longer pieces written directly for this site. More coming.</p>
    </div>
  </section>
</Layout>
