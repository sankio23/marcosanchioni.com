---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---

<Layout
  title="Marco Sanchioni — Philosophy of Physics"
  description="Marco Sanchioni — Associate Professor of Philosophy of Science at the Sophia University Institute. Foundations of physics and philosophy of science: quantum gravity, quantum mechanics, gauge theories, spacetime."
>
  <section class="hero cover">
    <div class="cover-media" aria-hidden="true">
      <img src={site.cover} alt="" width="1200" height="1117" fetchpriority="high" />
    </div>
    <div class="glow glow--accent glow--b" aria-hidden="true"></div>
    <div class="wrap">
      <div class="cover-body reveal">
        <span class="eyebrow">Philosophy of Physics</span>
        <h1>Marco Sanchioni</h1>
        <p class="role">Associate Professor of Philosophy of Science · Sophia University Institute</p>
        <p class="position-line lead serif">
          Foundations and philosophy of physics — quantum gravity, quantum mechanics, spacetime.
        </p>
        <div class="btn-row">
          <a href="/research" class="btn btn--primary">Explore the research</a>
          <a href="/publications" class="btn btn--ghost">Publications</a>
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="section-intro reveal">
        <span class="eyebrow">Research lines</span>
        <h2>Research areas</h2>
      </div>
      <div class="grid-research">
        <article class="rcard reveal">
          <span class="num">01</span>
          <h3>Quantum gravity &amp; black holes</h3>
          <p>Information loss, firewalls, and holography as a window into quantum gravity.</p>
        </article>
        <article class="rcard reveal">
          <span class="num">02</span>
          <h3>Relational quantum mechanics</h3>
          <p>Measurement, entanglement, and the status of quantum information.</p>
        </article>
        <article class="rcard reveal">
          <span class="num">03</span>
          <h3>Non-relativistic gravity &amp; spacetime</h3>
          <p>Newton–Cartan and Carrollian geometries, torsion, and the structure of time.</p>
        </article>
      </div>
      <div class="reveal btn-row btn-row--spaced">
        <a href="/research" class="btn btn--ghost">All research lines →</a>
      </div>
    </div>
  </section>

  <section class="band band--ink">
    <div class="glow glow--silver glow--c" aria-hidden="true"></div>
    <div class="wrap">
      <div class="about-grid">
        <div class="reveal">
          <span class="eyebrow">Recognition</span>
          <h2>Publications &amp; prizes</h2>
          <p class="lead measure" style="margin-top:1rem;">
            Articles in <em>Foundations of Physics</em>, <em>Synthese</em>, and the
            <em>British Journal for the Philosophy of Science</em>.
          </p>
          <div class="btn-row btn-row--spaced">
            <a href="/about" class="btn btn--primary">About &amp; CV</a>
          </div>
        </div>
        <div class="reveal">
          <ul class="info-list info-list--onlight">
            <li class="lead-item">Giulio Giorello Prize · 2021</li>
            <li class="lead-item">Graduate Student EPSA Essay Prize · 2023</li>
            <li class="lead-item">Blaumann Foundation Fellow · since 2022</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Layout>
