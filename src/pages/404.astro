---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found — Marco Sanchioni" description="This page does not exist on marcosanchioni.com. Use the navigation to reach the research, publications, teaching or blog sections.">
  <section class="wrap notfound">
    <div>
      <p class="code">404</p>
      <h1>Page not found</h1>
      <p class="lead" style="margin:1rem auto 2rem;max-width:44ch;">
        The page you were looking for has moved or never existed.
      </p>
      <div class="btn-row" style="justify-content:center;">
        <a href="/" class="btn btn--primary">Home</a>
        <a href="/publications" class="btn btn--ghost">Publications</a>
      </div>
    </div>
  </section>
</Layout>
