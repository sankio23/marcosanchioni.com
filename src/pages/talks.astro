---
import Layout from '../layouts/Layout.astro';
---

<Layout title={'Talks — Marco Sanchioni'} description={'Invited lectures, conference talks and seminars by Marco Sanchioni in the philosophy and foundations of physics.'}>
<section class="page-hero">
    <div class="glow glow--silver glow--a" aria-hidden="true"></div>
    <div class="wrap reveal">
      <span class="eyebrow">Talks</span>
      <h1>Lectures &amp; Presentations</h1>
      <p class="lead serif" style="max-width:58ch;">Invited lectures, conference presentations and seminars in the philosophy and foundations of physics.</p>
    </div>
  </section>

  <section class="band band--paper2">
    <div class="wrap">
      <div class="section-intro reveal">
        <h2>Invited &amp; Contributed Talks</h2>
      </div>

      <article class="pub reveal">
        <div class="year">2026</div>
        <div>
          <h3>The Meaning of Information in the Black Hole Information Paradox</h3>
          <p class="meta"><span class="venue">Perspectives on the Foundations of Information Theory and Statistical Mechanics</span> · Institute of Philosophy, Università della Svizzera italiana, Lugano · 9 May 2026</p>
        </div>
      </article>

      <article class="pub reveal">
        <div class="year">2025</div>
        <div>
          <h3>Matter and Spacetime Divide Between Supersymmetry and Supergravity</h3>
          <p class="meta"><span class="venue">Spacetime Matters</span> · University of Utrecht</p>
        </div>
      </article>

      <article class="pub reveal">
        <div class="year">2025</div>
        <div>
          <h3>On the Analogy between Higgs and Superconductivity</h3>
          <p class="meta"><span class="venue">PRIN 2022 Midterm Workshop</span> · Urbino</p>
        </div>
      </article>

      <article class="pub reveal">
        <div class="year">2024</div>
        <div>
          <h3>Conceptual Insights into Black Hole Paradoxes</h3>
          <p class="meta"><span class="venue">4th International FLAG Workshop</span> · University of Catania</p>
        </div>
      </article>

      <article class="pub reveal">
        <div class="year">2024</div>
        <div>
          <h3>Intelligenza artificiale e cercatori di Dio</h3>
          <p class="meta"><span class="venue">Conferenza Episcopale Umbra</span> · Città di Castello · in Italian</p>
        </div>
      </article>

      <article class="pub reveal">
        <div class="year">2023</div>
        <div>
          <h3>Reichenbach's Forgotten Argument</h3>
          <p class="meta"><span class="venue">Reading the Book of Nature</span> (400th Anniversary of Galileo's <em>Il Saggiatore</em>) · Florence</p>
        </div>
      </article>

      <article class="pub reveal">
        <div class="year">2023</div>
        <div>
          <h3>On Entanglement as a Relation</h3>
          <p class="meta"><span class="venue">EPSA23, European Philosophy of Science Association</span> · University of Belgrade</p>
          <p class="meta" style="margin-top:.3rem; color: var(--accent); font-weight:600;">Invited talk</p>
        </div>
      </article>

      <article class="pub reveal">
        <div class="year">2022</div>
        <div>
          <h3>On Entanglement as a Relation</h3>
          <p class="meta"><span class="venue">5th SILFS Postgraduate Conference</span> · University of Milano-Bicocca</p>
        </div>
      </article>

      <article class="pub reveal">
        <div class="year">2022</div>
        <div>
          <h3>Simultaneity in Non-Relativistic Quantum Gravity</h3>
          <p class="meta"><span class="venue">IAPT 7</span> · Barcelona &nbsp;·&nbsp; <span class="venue">ILMPS 2022</span> · Milan</p>
        </div>
      </article>

      <article class="pub reveal">
        <div class="year">2022</div>
        <div>
          <h3>No Membrane at the Black Hole Horizon?</h3>
          <p class="meta"><span class="venue">DPG Spring Meeting</span> · University of Heidelberg</p>
        </div>
      </article>

      <article class="pub reveal">
        <div class="year">2022</div>
        <div>
          <h3>Theoretical Advantages of Supersymmetry &nbsp;·&nbsp; Supersymmetry in a Nutshell</h3>
          <p class="meta"><span class="venue">University of Urbino</span></p>
        </div>
      </article>

      <article class="pub reveal">
        <div class="year">2021</div>
        <div>
          <h3>Complementarity Lost and Regained</h3>
          <p class="meta"><span class="venue">University of Urbino</span></p>
        </div>
      </article>

      <article class="pub reveal">
        <div class="year">2020</div>
        <div>
          <h3>How Many Properties of Spin Does a Particle Have?</h3>
          <p class="meta"><span class="venue">Synergia</span> · University of Urbino</p>
        </div>
      </article>

      <article class="pub reveal">
        <div class="year">2019</div>
        <div>
          <h3>Understanding Non-Commutative Geometry</h3>
          <p class="meta"><span class="venue">Synergia</span> · University of Urbino</p>
        </div>
      </article>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="section-intro reveal">
        <h2>Conference participation</h2>
      </div>

      <article class="pub reveal">
        <div class="year">2025</div>
        <div>
          <h3>Launch Conference, Centre for Philosophy of Artificial Intelligence (CPAI)</h3>
          <p class="meta"><span class="venue">Copenhagen</span></p>
        </div>
      </article>

      <article class="pub reveal">
        <div class="year">2024</div>
        <div>
          <h3>Halki Summit VI</h3>
          <p class="meta"><span class="venue">Ecumenical Patriarchate</span></p>
        </div>
      </article>
    </div>
  </section>
</Layout>
