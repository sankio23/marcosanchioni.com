---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---

<Layout
  title="About — Marco Sanchioni"
  description="Marco Sanchioni — Associate Professor of Philosophy of Science and Vice Rector at the Sophia University Institute, with dual doctorates in theoretical physics and philosophy of physics."
>
  <section class="page-hero">
    <div class="glow glow--silver glow--a" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="reveal">
        <span class="eyebrow">About</span>
        <h1>Marco Sanchioni</h1>
        <p class="lead serif measure">
          Associate Professor of Philosophy of Science · Vice Rector, Sophia University Institute ·
          Founding Director, International Center for Transdisciplinary Studies
        </p>
      </div>
      <div class="portrait reveal">
        <img src={site.portrait} alt="Portrait of Marco Sanchioni" width="800" height="1000" />
      </div>
    </div>
  </section>

  <section class="band band--paper2">
    <div class="wrap">
      <div class="about-grid">
        <div class="reveal stack">
          <p class="lead serif">
            I am Associate Professor of Philosophy of Science at the Sophia University Institute. My
            research delves into the foundations and philosophy of physics, with a particular focus
            on quantum gravity and black holes.
          </p>
          <p>
            My academic journey began with a PhD in theoretical physics at the Niels Bohr Institute,
            where I explored higher-dimensional black holes within quantum gravity frameworks. I
            later pursued a second PhD in philosophy of physics, examining the philosophical
            dimensions of the black hole information paradox.
          </p>
          <p>
            My contributions to these fields have been recognised with awards such as the Giulio
            Giorello Prize and the Graduate Student EPSA Prize.
          </p>
          <div class="btn-row">
            <a href={site.cv} class="btn btn--primary" download>Download CV (PDF)</a>
          </div>
        </div>

        <aside class="reveal">
          <div class="info-block">
            <h2>Education</h2>
            <ul class="info-list">
              <li>
                <span class="lead-item">PhD, Philosophy of Science</span><br />University of Urbino
                “Carlo Bo” — 2023<br /><em>“A Philosopher’s Take on the Black Hole Information
                Paradox”</em>, with Gino Tarozzi &amp; Vincenzo Fano
              </li>
              <li><span class="lead-item">Visiting PhD Student</span><br />University of Oxford — 2022</li>
              <li>
                <span class="lead-item">PhD, Theoretical Physics</span><br />Niels Bohr Institute,
                University of Copenhagen — 2018<br /><em>“Blackfolds and non-AdS Holography”</em>,
                with Niels A. Obers
              </li>
              <li>
                <span class="lead-item">Diploma in Theoretical Physics</span><br />SISSA —
                International School for Advanced Studies — 2013
              </li>
              <li>
                <span class="lead-item">MSc, Physics</span><br />University of Trento — 2013, 110/110
                cum laude<br />with Loriano Bonora
              </li>
              <li>
                <span class="lead-item">BSc, Physics</span><br />University of Bologna — 2011,
                110/110 cum laude<br />with Roberto Casadio
              </li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap info-grid">
      <div class="info-block reveal">
        <h2>Institutional roles</h2>
        <ul class="info-list">
          <li><span class="lead-item">Vice Rector</span><br />Sophia University Institute — since 2026</li>
          <li><span class="lead-item">Director, Doctoral School</span><br />Sophia University Institute — since 2026</li>
          <li>
            <span class="lead-item">Director, ICTS — International Center for Transdisciplinary Studies</span><br
            />Sophia University Institute — founding director, May 2026
          </li>
          <li>
            <span class="lead-item">Rector’s Delegate</span><br />Strategic Planning · Research,
            Chairs and Strategic Agreements · Site and Teaching-Infrastructure Planning — since 2025
          </li>
          <li>
            <span class="lead-item">Director of Research &amp; Director of the Post-Doctoral School</span
            ><br />Sophia University Institute — since 2024
          </li>
          <li><span class="lead-item">Vice-President, Board of Directors</span><br />Fondazione per Sophia — since 2024</li>
          <li>
            <span class="lead-item">Scientific Director, The AI Oath</span><br />International
            initiative for a professional oath on the design and deployment of AI, with Fadi Chehadé
            (former CEO, ICANN) — since 2023.<br />Research Lead and board member, The AI Oath
            Institute (California, 2026)
          </li>
          <li>
            <span class="lead-item">Associate Professor, Philosophy of Science</span><br />Sophia
            University Institute, Loppiano — since 2024
          </li>
          <li><span class="lead-item">Director, Pasquale Foresi Library</span><br />Sophia University Institute — 2023–2025</li>
        </ul>
      </div>

      <div class="info-block reveal">
        <h2>Awards</h2>
        <ul class="info-list">
          <li>EPSA Graduate Student Essay Prize — 2023</li>
          <li>Blaumann Foundation Call, foundations-of-physics projects — 2022</li>
          <li>Giulio Giorello Prize for the Philosophy of Science — 2021</li>
          <li>SISSA–UniTN Scholarship in theoretical physics — 2012</li>
          <li>Occhialini Scholarship — 2010</li>
        </ul>
      </div>

      <div class="info-block reveal">
        <h2>Grants &amp; research funding</h2>
        <ul class="info-list">
          <li>
            <span class="lead-item">ICTS founding programme</span><br />EUR 180,000 over three
            years, funded by Sophia University Institute and ASCES-UNITA — 2026–2029. Role: founding
            Director.
          </li>
          <li>
            <span class="lead-item">Porticus — Grant GR-077082</span><br />Post-Doctoral School,
            Sophia University Institute. EUR 380,000 over three years — 2024–2026. Role: Director of
            the Post-Doctoral School.
          </li>
          <li>
            <span class="lead-item">Blaumann Foundation</span><br />Winner of the Foundation’s first
            call for projects in the foundations of physics. EUR 10,000 — 2022.
          </li>
        </ul>
      </div>

      <div class="info-block reveal">
        <h2>Editorial boards &amp; refereeing</h2>
        <ul class="info-list">
          <li>Editorial Board, <em>Sophia: Research on Fundamentals and Correlation of Knowledge</em> — since 2024</li>
          <li>Scientific Committee, <em>Nuova Secondaria</em> (philosophy and science) — since 2022</li>
          <li>
            <span class="lead-item">Refereeing</span><br />European Journal for Philosophy of Science
            · Synthese · Foundations of Physics · Humanities and Social Sciences Communications ·
            Philosophical Inquiries · Quantum Reports · Sophia
          </li>
        </ul>
      </div>

      <div class="info-block reveal">
        <h2>Memberships</h2>
        <ul class="info-list">
          <li>Società Italiana degli Storici della Fisica e dell’Astronomia (SISFA) — since 2025</li>
          <li>Philosophy of Physics Society — since 2024</li>
          <li>Società Nuovo SEFIR — since 2023</li>
          <li>Blaumann Foundation — fellow since 2022</li>
          <li>British Society for the Philosophy of Science (BSPS) — since 2021</li>
          <li>European Philosophy of Science Association (EPSA) — since 2021</li>
          <li>Società Italiana di Logica e Filosofia delle Scienze (SILFS) — since 2021</li>
        </ul>
      </div>

      <div class="info-block reveal">
        <h2>Organisation of events</h2>
        <ul class="info-list">
          <li>XXIX Urbino Int. Summer School in Philosophy of Physics — <em>History and Philosophy of the Wave Function</em>, 15–19 June 2026. Co-organiser (with N. Covoni).</li>
          <li><em>Relational Quantum Mechanics and the Ontology of Physical Reality</em>, international workshop, SILFS-sponsored, 2026. Co-organiser (with N. Covoni).</li>
          <li>XXVIII Int. Summer School in Philosophy of Physics — <em>Epistemology of Quantum Gravity</em>, Urbino, 2025. Co-organiser.</li>
          <li>XXVII Int. Summer School in Philosophy of Physics — <em>Philosophy of Dark Energy</em>, Urbino, 2024. Co-organiser.</li>
          <li><em>Intelligenza Artificiale — Verso un Digital Oath</em>, Sophia University Institute, 2024. Coordinator of the Scientific Programme.</li>
          <li>XXVI Int. Summer School in Philosophy of Physics — <em>Philosophy of Dark Matter</em>, Urbino, 2023. Co-organiser.</li>
          <li>Blaumann Foundation Conference — <em>Quantum Gravity with(out) Experiments</em>, Urbino, 2023. Main organiser.</li>
          <li>XXV Int. Summer School in Philosophy of Physics — <em>Dualities Between Physics and Philosophy</em>, Urbino, 2022. Co-organiser.</li>
          <li>XXIV Int. Summer School in Philosophy of Physics — <em>Black Holes and the Information Loss Paradox</em>, Urbino, 2021. Co-organiser.</li>
        </ul>
      </div>

      <div class="info-block reveal">
        <h2>Doctoral supervision</h2>
        <ul class="info-list">
          <li><span class="lead-item">Since 2024</span><br />Lucia Salari · Andrea Galluzzi · Marianne Najm Abou-Jaoude (Sophia University Institute)</li>
          <li><span class="lead-item">2025–2026</span><br />Post-doctoral evaluation committee: A. Borghesi (Sophia University Institute)</li>
        </ul>
      </div>

      <div class="info-block reveal">
        <h2>Academic profiles</h2>
        <ul class="info-list">
          <li><a href={site.orcid} target="_blank" rel="noopener">ORCID 0000-0002-7846-3633 ↗</a></li>
          <li><a href={site.scholar} target="_blank" rel="noopener">Google Scholar ↗</a></li>
          <li><a href={site.philpeople} target="_blank" rel="noopener">PhilPeople ↗</a></li>
          <li><a href={site.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a></li>
          <li><a href={site.cv} download>Curriculum Vitae (PDF)</a></li>
        </ul>
      </div>

      <div class="info-block reveal">
        <h2>Languages</h2>
        <ul class="info-list">
          <li>Italian — native</li>
          <li>English — fluent (C1)</li>
          <li>Romanian — B1</li>
        </ul>
      </div>
    </div>
  </section>
</Layout>

<style>
  .info-block h2 {
    font-family: var(--display);
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--accent);
    display: inline-block;
  }
</style>
