---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
};

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  author: { '@type': 'Person', name: 'Marco Sanchioni', url: 'https://www.marcosanchioni.com' },
  mainEntityOfPage: new URL(`/blog/${post.id}`, 'https://www.marcosanchioni.com').href,
};
---

<Layout
  title={`${post.data.title} — Marco Sanchioni`}
  description={post.data.description}
  ogType="article"
  jsonLd={articleLd}
  publishedTime={post.data.date.toISOString()}
>
  <article>
    <section class="page-hero">
      <div class="glow glow--silver glow--a" aria-hidden="true"></div>
      <div class="wrap">
        <div class="column reveal">
          <p class="post-meta">
            <a href="/blog">Blog</a> ·
            <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
            {post.data.updated && <> · updated {fmt(post.data.updated)}</>}
          </p>
          <h1>{post.data.title}</h1>
          <p class="lead serif">{post.data.description}</p>
          {
            post.data.tags.length > 0 && (
              <div class="post-tags">
                {post.data.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
            )
          }
        </div>
      </div>
    </section>

    <section class="band band--paper2">
      <div class="wrap">
        <div class="column">
          <div class="prose reveal">
            <Content />
          </div>
          <p class="back-link"><a href="/blog">← All posts</a></p>
        </div>
      </div>
    </section>
  </article>
</Layout>

<style>
  /* One reading column, centred on the page. The measure stays around 70
     characters — the point at which the eye still finds the next line. */
  .column {
    max-width: 72ch;
    margin-inline: auto;
  }
  .column h1 {
    font-size: clamp(2rem, 4.5vw, 3.2rem);
  }
  .column .lead {
    max-width: 60ch;
  }
  .column .prose {
    max-width: none;
  }
  .back-link {
    margin-top: 3rem;
    font-family: var(--display);
    font-size: 0.92rem;
  }
</style>
