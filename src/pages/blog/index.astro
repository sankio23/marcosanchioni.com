---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout
  title="Blog — Marco Sanchioni"
  description="Notes and essays on the foundations of physics, philosophy of science, and the ethics of artificial intelligence."
>
  <section class="page-hero">
    <div class="glow glow--silver glow--a" aria-hidden="true"></div>
    <div class="wrap reveal">
      <span class="eyebrow">Blog</span>
      <h1>Notes</h1>
      <p class="lead serif" style="max-width:58ch;">
        Shorter pieces on the foundations of physics, the philosophy of science, and the ethics of
        artificial intelligence — written between papers.
      </p>
    </div>
  </section>

  <section class="band band--paper2">
    <div class="wrap">
      {
        posts.length === 0 ? (
          <p class="lead">No posts yet.</p>
        ) : (
          <ul class="post-list">
            {posts.map((post) => (
              <li class:list={['post-item', 'reveal', !post.data.hero && 'post-item--plain']}>
                {post.data.hero && (
                  <a class="post-thumb" href={`/blog/${post.id}`} tabindex="-1" aria-hidden="true">
                    <img
                      src={post.data.thumb ?? post.data.hero}
                      alt=""
                      width="720"
                      height="450"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                )}
                <div class="post-body">
                  <p class="post-meta">
                    <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
                  </p>
                  <h2><a href={`/blog/${post.id}`}>{post.data.title}</a></h2>
                  <p>{post.data.description}</p>
                  {post.data.tags.length > 0 && (
                    <div class="post-tags">
                      {post.data.tags.map((t) => <span class="tag">{t}</span>)}
                    </div>
                  )}
                </div>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</Layout>

<style>
  /* The list becomes a two-column card: picture, then text. A post with no
     picture keeps the full measure rather than leaving a hole where the
     thumbnail would be. The image is decorative — the title is the link
     that matters — so it is hidden from assistive technology. */
  .post-item {
    display: grid;
    grid-template-columns: minmax(0, 16rem) 1fr;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: start;
  }
  .post-item--plain { grid-template-columns: 1fr; }

  .post-thumb {
    display: block;
    overflow: hidden;
    border: 1px solid var(--line-soft);
    border-radius: 3px;
    background: var(--surface);
  }
  .post-thumb img {
    width: 100%;
    /* The width/height attributes are presentational hints; without
       height:auto the definite height wins and aspect-ratio is ignored. */
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    opacity: 0.82;
    transition: opacity 0.35s ease, transform 0.6s ease;
  }
  .post-item:hover .post-thumb img,
  .post-item:focus-within .post-thumb img {
    opacity: 1;
    transform: scale(1.035);
  }

  .post-body p { max-width: 62ch; }

  @media (prefers-reduced-motion: reduce) {
    .post-thumb img { transition: none; }
    .post-item:hover .post-thumb img { transform: none; }
  }

  @media (max-width: 760px) {
    .post-item { grid-template-columns: 1fr; gap: 1.1rem; }
    .post-thumb img { aspect-ratio: 2 / 1; }
  }
</style>
