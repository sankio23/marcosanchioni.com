---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout
  title="Notes — Marco Sanchioni"
  description="Marco Sanchioni — whatever I happen to be thinking about, written down before it is settled. Sometimes it comes out of the work, sometimes out of a trip or a conversation."
>
  {/* The list speaks for itself, so nothing is printed above it. The
      heading stays in the markup, hidden, because a page with no h1 has
      no name for a screen reader navigating by headings. */}
  <h1 class="visually-hidden">Notes</h1>

  <section class="band band--paper2 band--first">
    <div class="wrap">
      {
        posts.length === 0 ? (
          <p class="lead">No posts yet.</p>
        ) : (
          <ul class="card-list">
            {posts.map((post, i) => (
              <li class:list={['card', 'reveal', !post.data.hero && 'card--plain', i === 0 && 'card--latest']}>
                {post.data.hero && (
                  <div class="card__media" aria-hidden="true">
                    <img
                      src={post.data.hero}
                      srcset={post.data.thumb ? `${post.data.thumb} 900w, ${post.data.hero} 1800w` : undefined}
                      sizes="(max-width: 760px) 100vw, 1180px"
                      alt=""
                      width="1800"
                      height="900"
                      loading={i === 0 ? 'eager' : 'lazy'}
                      fetchpriority={i === 0 ? 'high' : undefined}
                      decoding="async"
                    />
                  </div>
                )}
                <div class="card__body">
                  <p class="post-meta">
                    {i === 0 && <span class="badge">Latest</span>}
                    <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
                  </p>
                  <h2><a href={`/blog/${post.id}`}>{post.data.title}</a></h2>
                  <p>{post.data.description}</p>
                  {post.data.tags.length > 0 && (
                    <div class="post-tags">
                      {post.data.tags.map((t) => <span class="tag">{t}</span>)}
                    </div>
                  )}
                </div>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</Layout>

<style>
  /* Present to assistive technology and to search engines, absent from
     the page. Not display:none, which would remove it from both. */
  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    margin: -1px; padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* Nothing above it, so the band opens the page. */
  .band--first { padding-block: clamp(2.5rem, 5vw, 4rem) clamp(3rem, 6vw, 5rem); }

  /* Each entry is a card with its picture behind the text, in the same
     idiom as the post pages. A post with no picture falls back to a flat
     surface rather than an empty frame. */
  .card-list { list-style: none; display: grid; gap: 1.5rem; }

  .card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border: 1px solid var(--line-soft);
    border-radius: 4px;
    display: flex;
    align-items: flex-end;
    min-height: clamp(15rem, 26vh, 19rem);
    padding: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  .card__media { position: absolute; inset: 0; z-index: -2; }
  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
  }
  .card:hover .card__media img,
  .card:focus-within .card__media img { transform: scale(1.03); }

  /* Scrim: a flat wash that guarantees the contrast ratio, plus a
     bottom-weighted gradient that anchors the text. */
  .card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgba(10,10,11,.95) 0%, rgba(10,10,11,.82) 40%, rgba(10,10,11,.44) 100%),
      radial-gradient(115% 95% at 10% 85%, rgba(10,10,11,.60), transparent 72%),
      rgba(10,10,11,.28);
  }

  .card__body {
    position: relative;
    max-width: 60ch;
    text-shadow: 0 1px 24px rgba(0,0,0,.6), 0 1px 3px rgba(0,0,0,.45);
  }
  .card .post-meta { color: var(--ink-soft); margin-bottom: 0.35rem; }
  .card h2 { font-size: clamp(1.4rem, 3vw, 1.9rem); margin-bottom: 0.5rem; }
  .card h2 a { color: var(--ink); }
  .card h2 a:hover { color: var(--accent-soft); }
  .card p { color: var(--ink-soft); }

  /* The most recent entry, marked once. "Latest" rather than "new" because a
     static page cannot know how long it has been sitting there — the first
     word stays true, the second would quietly become a lie. */
  .card--latest { border-color: rgba(182, 240, 74, 0.42); }
  .card--latest::before {
    content: "";
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 3px;
    background: linear-gradient(to bottom, var(--accent), rgba(182,240,74,0.25));
    z-index: 1;
  }
  .badge {
    display: inline-block;
    margin-right: 0.7rem;
    padding: 0.1rem 0.5rem;
    border: 1px solid rgba(182, 240, 74, 0.5);
    border-radius: 999px;
    color: var(--accent);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    vertical-align: 0.08em;
  }

  .card--plain {
    background: var(--surface);
    min-height: 0;
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }
  .card--plain .card__body { text-shadow: none; }

  @media (prefers-reduced-motion: reduce) {
    .card__media img { transition: none; }
    .card:hover .card__media img { transform: none; }
  }

  @media (max-width: 640px) {
    .card { min-height: 13rem; padding: 1.4rem; }
  }
</style>
