---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout
  title="Notes — Marco Sanchioni"
  description="Notes and essays on the foundations of physics, philosophy of science, and the ethics of artificial intelligence."
>
  <section class="page-hero page-hero--tight">
    <div class="glow glow--silver glow--a" aria-hidden="true"></div>
    <div class="wrap reveal">
      <h1>Notes</h1>
      <p class="lead serif">
        Shorter pieces on the foundations of physics, the philosophy of science, and the ethics of
        artificial intelligence — written between papers.
      </p>
    </div>
  </section>

  <section class="band band--paper2">
    <div class="wrap">
      {
        posts.length === 0 ? (
          <p class="lead">No posts yet.</p>
        ) : (
          <ul class="card-list">
            {posts.map((post, i) => (
              <li class:list={['card', 'reveal', !post.data.hero && 'card--plain']}>
                {post.data.hero && (
                  <div class="card__media" aria-hidden="true">
                    <img
                      src={post.data.hero}
                      srcset={post.data.thumb ? `${post.data.thumb} 900w, ${post.data.hero} 1800w` : undefined}
                      sizes="(max-width: 760px) 100vw, 1180px"
                      alt=""
                      width="1800"
                      height="900"
                      loading={i === 0 ? 'eager' : 'lazy'}
                      fetchpriority={i === 0 ? 'high' : undefined}
                      decoding="async"
                    />
                  </div>
                )}
                <div class="card__body">
                  <p class="post-meta">
                    <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
                  </p>
                  <h2><a href={`/blog/${post.id}`}>{post.data.title}</a></h2>
                  <p>{post.data.description}</p>
                  {post.data.tags.length > 0 && (
                    <div class="post-tags">
                      {post.data.tags.map((t) => <span class="tag">{t}</span>)}
                    </div>
                  )}
                </div>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</Layout>

<style>
  /* The list follows immediately, so this header does not need the full
     landing-page height: it names the section and gets out of the way. */
  .page-hero--tight { padding-block: clamp(2.25rem, 4vw, 3.25rem) clamp(1.5rem, 2.5vw, 2rem); }
  .page-hero--tight h1 { margin: 0 0 .6rem; font-size: clamp(2rem, 4vw, 2.7rem); }
  .page-hero--tight .lead { max-width: 56ch; }

  /* Each entry is a card with its picture behind the text, in the same
     idiom as the post pages. A post with no picture falls back to a flat
     surface rather than an empty frame. */
  .card-list { list-style: none; display: grid; gap: 1.5rem; }

  .card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border: 1px solid var(--line-soft);
    border-radius: 4px;
    display: flex;
    align-items: flex-end;
    min-height: clamp(15rem, 26vh, 19rem);
    padding: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  .card__media { position: absolute; inset: 0; z-index: -2; }
  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
  }
  .card:hover .card__media img,
  .card:focus-within .card__media img { transform: scale(1.03); }

  /* Scrim: a flat wash that guarantees the contrast ratio, plus a
     bottom-weighted gradient that anchors the text. */
  .card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgba(10,10,11,.95) 0%, rgba(10,10,11,.82) 40%, rgba(10,10,11,.44) 100%),
      radial-gradient(115% 95% at 10% 85%, rgba(10,10,11,.60), transparent 72%),
      rgba(10,10,11,.28);
  }

  .card__body {
    position: relative;
    max-width: 60ch;
    text-shadow: 0 1px 24px rgba(0,0,0,.6), 0 1px 3px rgba(0,0,0,.45);
  }
  .card .post-meta { color: var(--ink-soft); margin-bottom: 0.35rem; }
  .card h2 { font-size: clamp(1.4rem, 3vw, 1.9rem); margin-bottom: 0.5rem; }
  .card h2 a { color: var(--ink); }
  .card h2 a:hover { color: var(--accent-soft); }
  .card p { color: var(--ink-soft); }

  .card--plain {
    background: var(--surface);
    min-height: 0;
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }
  .card--plain .card__body { text-shadow: none; }

  @media (prefers-reduced-motion: reduce) {
    .card__media img { transition: none; }
    .card:hover .card__media img { transform: none; }
  }

  @media (max-width: 640px) {
    .card { min-height: 13rem; padding: 1.4rem; }
  }
</style>
